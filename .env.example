# Copy to .env (run.py does this for you and fills in random keys).

# Shared secret between Django and the FastAPI engine. Required.
SERVICE_API_KEY=change-me

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
FASTAPI_BASE_URL=http://127.0.0.1:8001

# Engine database. Unset = SQLite file backend/safest_bank.db. Postgres works too
# (e.g. Neon); run `python backend/seed.py --reset` after pointing it at a database.
# DATABASE_URL=postgresql://user:pass@host/db

# DEMO_MODE=true enables the "Simulate" panel on Send Money and logs OTPs to the
# engine console when no n8n webhook is configured. Turn off for anything real.
DEMO_MODE=true

# n8n workflow (backend/n8n/The-Safest-Bank.json). Leave empty to skip delivery.
N8N_WEBHOOK_URL=
# Optional: sent as X-Webhook-Secret; configure the Webhook node's Header Auth to match.
N8N_WEBHOOK_SECRET=

# Demo customers get this inbox (plus-addressed, e.g. you+aarav@gmail.com) so OTP
# emails from n8n reach you. Empty = @example.com addresses.
DEMO_OTP_EMAIL=
